# ==============================================================================
# PsicArte - Variables de Entorno de Ejemplo (.env.example)
# Copia este archivo como .env y completa los valores correspondientes.
# ==============================================================================

# Puerto en el que se ejecuta el servidor Node.js/Express
PORT=3000

# Clave secreta para la firma y verificación de tokens JWT (Panel Admin / Sesiones)
JWT_SECRET=Rocket_SALvaje_con_cuerpo_REDondin5478

# Pasarela de Pagos Khipu (API v3.0).
# Para pruebas, usa la cuenta de pruebas y DemoBank; la API v3 mantiene esta URL base y autentica solo con x-api-key.
KHIPU_API_KEY=e5b55109-670f-4930-84fa-147ba36e6b1e
KHIPU_API_URL=https://payment-api.khipu.com/v3

# URL pública de tu aplicación (necesaria para return_url, cancel_url y notify_url de Khipu)
# Para recibir notificaciones desde Khipu, debe ser una URL pública accesible por HTTPS.
# En desarrollo local, usar un túnel HTTPS (ej: https://abc123.ngrok-free.app).
# En producción: el dominio público con HTTPS (ej: https://centropsicarte.cl)
# Compatible tanto con APP_URL como con KHIPU_BASE_URL:
APP_URL=https://centropsicarte.cl

# Opciones de base de datos
# Cambiar a 'true' si se desea regenerar y resetear la base de datos SQLite al iniciar
RESET_DB=false

# Configuración SMTP para Envío de Correos de Confirmación (Nodemailer)
# Si se dejan vacíos en desarrollo, el servidor registrará el contenido del correo en consola.
SMTP_HOST=mail.centropsicarte.cl
SMTP_PORT=465
SMTP_USER=contacto@centropsicarte.cl
SMTP_PASS=02038980onj
SMTP_FROM="Centro Integral PsicArte <contacto@centropsicarte.cl>"
