# ==============================================================================
# PsicArte - Variables de Entorno de Ejemplo (.env.example)
# Copia este archivo como .env y completa los valores correspondientes.
# ==============================================================================

# Puerto en el que se ejecuta el servidor Node.js/Express
PORT=3000

# Clave secreta para la firma y verificación de tokens JWT (Panel Admin / Sesiones)
JWT_SECRET=tu_clave_secreta_jwt_aqui

# Pasarela de Pagos Khipu (API v3)
# Obtener desde: https://khipu.com -> Opciones de la cuenta de cobro -> "Para integrar Khipu a tu sitio web"
# Identificador de cobrador (id_cobrador)
KHIPU_RECEIVER_ID=tu_receiver_id_aqui

# Clave secreta / API Key v3 generada en el portal Khipu
KHIPU_API_KEY=tu_api_key_v3_aqui

# URL base del servidor (necesaria para return_url, cancel_url y notify_url de Khipu)
# En desarrollo local: usar URL pública de ngrok o similar con HTTPS (ej: https://abc123.ngrok-free.app)
# En producción: el dominio público con HTTPS (ej: https://tudominio.com)
KHIPU_BASE_URL=http://localhost:3000

# Opciones de base de datos
# Cambiar a 'true' si se desea regenerar y resetear la base de datos SQLite al iniciar
RESET_DB=false
